{
  "name": "@thoughtbot/candy_wrapper",
  "version": "0.0.4",
  "description": "Use rails forms with popular react UI libraries",
  "workspaces": [
    "wrappers/ts/vanilla",
    "wrappers/ts/mantine/v9",
    "wrappers/ts/shadcn/v4",
    "wrappers/ts/react-aria/v1",
    "wrappers/ts/react-spectrum/v3",
    "wrappers/ts/react-spectrum/s2",
    "wrappers/ts/heroui/v3",
    "wrappers/ts/mui/v9",
    "wrappers/ts/chakra/v3"
  ],
  "scripts": {
    "build": "tsup",
    "build:wrappers": "npm run build --workspaces --if-present",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "run-p lint:eslint lint:types lint:prettier",
    "typecheck:wrappers": "npm run typecheck --workspaces --if-present",
    "lint:eslint": "eslint --max-warnings=0 --ext js,jsx,ts,tsx",
    "lint:prettier": "prettier --check '**/*' --ignore-unknown",
    "lint:types": "tsc",
    "fix:prettier": "prettier --write '**/*' --ignore-unknown",
    "test": "TZ=UTC vitest",
    "test:run": "vitest run",
    "test:cov": "vitest --coverage",
    "test:all": "npm lint && npm test:run",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "pub:beta": "npm build && npm publish --tag beta",
    "pub:release": "npm build && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thoughtbot/candy_wrapper.git"
  },
  "author": "Johny Ho",
  "main": "dist/cjs/candy_wrapper.cjs",
  "module": "dist/candy_wrapper.mjs",
  "types": "dist/candy_wrapper.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/candy_wrapper.d.mts",
      "import": "./dist/candy_wrapper.mjs",
      "default": "./dist/cjs/candy_wrapper.cjs"
    }
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thoughtbot/candy_wrapper/issues"
  },
  "homepage": "https://github.com/thoughtbot/candy_wrapper#readme",
  "devDependencies": {
    "@react-aria/test-utils": "^1.0.0-alpha.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.0.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-vitest-globals": "^1.5.0",
    "happy-dom": "^15.7.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.3.1",
    "prettier-eslint": "^16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.1.0",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-plugin-missing-exports": "^4.0.0",
    "typescript": "^5.5.3",
    "vitest": "^2.0.2"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  }
}
